<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TOEFLSimulation.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <!-- Theme-aware text and icon colors for elements built in code (the Mac app's TOEFLTheme). -->
        <Style x:Key="TextPrimary" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="TextSecondary" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TextTertiary" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="TextNavy" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource NavyBrush}" />
        </Style>
        <Style x:Key="TextBlue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource BlueBrush}" />
        </Style>
        <Style x:Key="TextTeal" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TealBrush}" />
        </Style>
        <Style x:Key="TextGold" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource BrandGoldBrush}" />
        </Style>
        <Style x:Key="TextCritical" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="IconPrimary" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="IconSecondary" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="IconTertiary" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="IconNavy" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource NavyBrush}" />
        </Style>
        <Style x:Key="IconBlue" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource BlueBrush}" />
        </Style>
        <Style x:Key="IconTeal" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TealBrush}" />
        </Style>
        <Style x:Key="IconGold" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource BrandGoldBrush}" />
        </Style>
        <Style x:Key="IconCritical" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <!-- A clickable card (the Mac app's .toeflCard() inside a plain Button). -->
        <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <!-- An inset panel inside a card (the Mac app's input-colored review cards). -->
        <Style x:Key="InsetStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1,7,2" />
        </Style>
        <Style x:Key="DividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="ListScroller" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}" MaxWidth="950" Spacing="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Score history" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource NavyBrush}" />
                        <TextBlock Text="Practice results stay on this device." TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="ClearButton" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"
                            Click="OnClearClick" AutomationProperties.Name="Clear history">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="Clear history" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ProgressRing x:Name="LoadingRing" IsActive="True" HorizontalAlignment="Left" />

                <!-- Empty state (ContentUnavailableView). -->
                <Border x:Name="EmptyCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel MinHeight="420" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D2;" FontSize="44" Margin="0,150,0,6" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No completed tests" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Complete a practice session to create a score report." HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ResultsPanel" Spacing="20" />
            </StackPanel>
        </ScrollViewer>

        <!-- A saved report opens over the list, like the Mac app's full-page overlay. -->
        <Grid x:Name="ReportHost" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
        </Grid>
    </Grid>
</Page>
