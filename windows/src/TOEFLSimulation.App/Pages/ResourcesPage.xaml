<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TOEFLSimulation.App.Pages.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <!-- Theme-aware text and icon colors for elements built in code (the Mac app's TOEFLTheme). -->
        <Style x:Key="TextPrimary" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="TextSecondary" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TextTertiary" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="TextNavy" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource NavyBrush}" />
        </Style>
        <Style x:Key="TextBlue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource BlueBrush}" />
        </Style>
        <Style x:Key="TextTeal" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TealBrush}" />
        </Style>
        <Style x:Key="TextGold" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource BrandGoldBrush}" />
        </Style>
        <Style x:Key="TextCritical" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="IconPrimary" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="IconSecondary" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="IconTertiary" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="IconNavy" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource NavyBrush}" />
        </Style>
        <Style x:Key="IconBlue" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource BlueBrush}" />
        </Style>
        <Style x:Key="IconTeal" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TealBrush}" />
        </Style>
        <Style x:Key="IconGold" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource BrandGoldBrush}" />
        </Style>
        <Style x:Key="IconCritical" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <!-- A clickable card (the Mac app's .toeflCard() inside a plain Button). -->
        <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <!-- An inset panel inside a card (the Mac app's input-colored review cards). -->
        <Style x:Key="InsetStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1,7,2" />
        </Style>
        <Style x:Key="DividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource PageContentStyle}" MaxWidth="950" Spacing="20">
            <TextBlock x:Name="TitleText" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource NavyBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="IntroductionText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="18">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE82D;" FontSize="14" Foreground="{ThemeResource TealBrush}" />
                    <TextBlock x:Name="VocabularyCountText" Text="Vocabulary entries" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TealBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{ThemeResource TealBrush}" />
                    <TextBlock Text="Offline study cards" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TealBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Current official references" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
                    <StackPanel x:Name="ReferencesPanel" Spacing="2" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="FreePracticeTitleText" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="FreePracticeNoteText" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="FreePracticePanel" Spacing="2" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="LocalLibraryTitleText" FontSize="22" FontWeight="Bold" />
                    <StackPanel x:Name="LocalSourcesPanel" Spacing="12" />
                    <TextBlock x:Name="LocalLibraryNoteText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TrademarkText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
