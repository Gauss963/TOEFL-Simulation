<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TOEFLSimulation.App.Pages.VocabularyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TOEFLSimulation.App.Controls"
    xmlns:pages="using:TOEFLSimulation.App.Pages"
    PreviewKeyDown="OnPagePreviewKeyDown">
    <Page.Resources>
        <!-- Theme-aware text and icon colors for elements built in code (the Mac app's TOEFLTheme). -->
        <Style x:Key="TextPrimary" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="TextSecondary" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TextTertiary" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="TextNavy" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource NavyBrush}" />
        </Style>
        <Style x:Key="TextBlue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource BlueBrush}" />
        </Style>
        <Style x:Key="TextTeal" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TealBrush}" />
        </Style>
        <Style x:Key="TextGold" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource BrandGoldBrush}" />
        </Style>
        <Style x:Key="TextCritical" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="IconPrimary" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="IconSecondary" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="IconTertiary" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="IconNavy" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource NavyBrush}" />
        </Style>
        <Style x:Key="IconBlue" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource BlueBrush}" />
        </Style>
        <Style x:Key="IconTeal" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TealBrush}" />
        </Style>
        <Style x:Key="IconGold" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource BrandGoldBrush}" />
        </Style>
        <Style x:Key="IconCritical" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <!-- A clickable card (the Mac app's .toeflCard() inside a plain Button). -->
        <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <!-- An inset panel inside a card (the Mac app's input-colored review cards). -->
        <Style x:Key="InsetStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1,7,2" />
        </Style>
        <Style x:Key="DividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="BlockTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CompletionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CompletionText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="560" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource PageContentStyle}" MaxWidth="1050">
            <StackPanel Spacing="7">
                <TextBlock x:Name="TitleText" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" Foreground="{ThemeResource NavyBrush}" />
                <TextBlock x:Name="SubtitleText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <SelectorBar x:Name="ModeSelector" SelectionChanged="OnStudyModeChanged" AutomationProperties.Name="Study mode">
                <SelectorBarItem x:Name="BrowseItem" Text="Browse" IsSelected="True">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE82D;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="FlashCardsItem" Text="Flash Cards">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <ProgressRing x:Name="LoadingRing" IsActive="True" HorizontalAlignment="Left" />

            <!-- Browse: search, source filter, and reveal-on-click word cards. -->
            <StackPanel x:Name="BrowsePanel" Spacing="18" Visibility="Collapsed">
                <controls:WrapFlowPanel HorizontalSpacing="12" VerticalSpacing="10">
                    <AutoSuggestBox x:Name="SearchBox" Width="420" QueryIcon="Find" TextChanged="OnSearchTextChanged"
                                    AutomationProperties.Name="Search vocabulary" />
                    <ComboBox x:Name="BrowseSourceBox" MinWidth="220" MaxWidth="380" SelectionChanged="OnBrowseSourceChanged"
                              AutomationProperties.Name="Source" />
                    <TextBlock x:Name="WordCountText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </controls:WrapFlowPanel>

                <ItemsRepeater x:Name="CardsRepeater" SizeChanged="OnCardsRepeaterSizeChanged">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="14" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <pages:VocabularyRowPresenter />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock x:Name="NoMatchesText" Text="No words match your search." Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="FootnoteText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Flash cards: deck settings, progress, the card, and rating. -->
            <StackPanel x:Name="FlashPanel" Spacing="18" Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Flash-card session" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Mastery is saved on this device." FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                                    Padding="8" AutomationProperties.Name="Flash-card options" ToolTipService.ToolTip="Flash-card options">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="Reset mastery progress" Click="OnResetProgressClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <controls:WrapFlowPanel HorizontalSpacing="14" VerticalSpacing="12" ItemVerticalAlignment="Bottom">
                            <ComboBox x:Name="FlashSourceBox" Header="Source" MinWidth="220" MaxWidth="380"
                                      SelectionChanged="OnFlashSourceChanged" />
                            <ComboBox x:Name="FlashModeBox" Header="Mode" MinWidth="150" SelectionChanged="OnFlashModeChanged" />
                            <ComboBox x:Name="DeckSizeBox" Header="Deck size" MinWidth="130" SelectionChanged="OnDeckSizeChanged" />
                            <ToggleSwitch x:Name="UnmasteredSwitch" Header="Unmastered only" Toggled="OnUnmasteredToggled" />
                        </controls:WrapFlowPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                                <TextBlock x:Name="AvailableText" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB95;" FontSize="13" Foreground="{ThemeResource TealBrush}" />
                                <TextBlock x:Name="MasteredText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TealBrush}" />
                            </StackPanel>
                            <Button x:Name="NewDeckButton" Grid.Column="3" Click="OnNewDeckClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Fixed-deck progress. -->
                <StackPanel x:Name="DeckProgressPanel" Spacing="8">
                    <Grid>
                        <TextBlock x:Name="DeckProgressTitleText" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="DeckProgressDetailText" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ProgressBar x:Name="DeckProgressBar" Minimum="0" Maximum="1" Foreground="{ThemeResource TealBrush}" />
                </StackPanel>

                <!-- Infinite-loop progress. -->
                <StackPanel x:Name="InfiniteProgressPanel" Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8EE;" FontSize="14" />
                            <TextBlock Text="Infinite loop" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="InfiniteProgressDetailText" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ProgressBar x:Name="InfiniteProgressBar" Minimum="0" Maximum="1" Foreground="{ThemeResource TealBrush}" />
                    <TextBlock x:Name="InfiniteNoteText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- The card: click (or Space) reveals the back. -->
                <ContentControl x:Name="CardHost" IsTabStop="True" UseSystemFocusVisuals="True"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Tapped="OnCardTapped" AutomationProperties.Name="Flash card">
                    <Border CornerRadius="12" Padding="32" MinHeight="390"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel x:Name="FrontPanel" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel x:Name="FrontHighFrequency" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{ThemeResource BrandGoldBrush}" />
                                    <TextBlock Text="High frequency" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource BrandGoldBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="FrontWordText" FontFamily="Georgia" FontSize="48" FontWeight="Bold"
                                           TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock x:Name="FrontDetailText" FontSize="20" TextAlignment="Center" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="FrontSpeakButton" HorizontalAlignment="Center" Click="OnSpeakClick">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon x:Name="FrontSpeakIcon" Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource BlueBrush}" />
                                        <TextBlock x:Name="FrontSpeakText" Text="Hear pronunciation" Foreground="{ThemeResource BlueBrush}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <FontIcon Glyph="&#xE7C4;" FontSize="14" Foreground="{ThemeResource BlueBrush}" />
                                    <TextBlock Text="Press V to hear · Click the card or press Space to reveal" TextWrapping="Wrap"
                                               Foreground="{ThemeResource BlueBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="BackPanel" Spacing="13" Visibility="Collapsed">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:WrapFlowPanel HorizontalSpacing="10" VerticalSpacing="4" ItemVerticalAlignment="Bottom">
                                        <TextBlock x:Name="BackWordText" FontFamily="Georgia" FontSize="32" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="BackPronunciationText" FontSize="13" Margin="0,0,0,6"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="BackPartOfSpeechText" FontSize="12" Margin="0,0,0,6"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </controls:WrapFlowPanel>
                                    <Button x:Name="BackSpeakButton" Grid.Column="1" VerticalAlignment="Center" Click="OnSpeakClick">
                                        <FontIcon x:Name="BackSpeakIcon" Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource BlueBrush}" />
                                    </Button>
                                    <FontIcon x:Name="BackHighFrequencyIcon" Grid.Column="2" Glyph="&#xE735;" FontSize="16"
                                              VerticalAlignment="Center" Foreground="{ThemeResource BrandGoldBrush}"
                                              AutomationProperties.Name="High frequency" />
                                </Grid>
                                <Border Style="{StaticResource DividerStyle}" />
                                <StackPanel x:Name="BackDefinitionBlock" Spacing="4">
                                    <TextBlock Text="English definition" Style="{StaticResource BlockTitle}" />
                                    <TextBlock x:Name="BackDefinitionText" FontWeight="Medium" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Taiwan Traditional Chinese" Style="{StaticResource BlockTitle}" />
                                    <TextBlock x:Name="BackChineseText" FontWeight="Medium" TextWrapping="Wrap" Language="zh-TW"
                                               IsTextSelectionEnabled="True" Foreground="{ThemeResource TealBrush}" />
                                </StackPanel>
                                <StackPanel x:Name="BackSynonymsBlock" Spacing="4">
                                    <TextBlock Text="Synonyms" Style="{StaticResource BlockTitle}" />
                                    <TextBlock x:Name="BackSynonymsText" FontWeight="Medium" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <TextBlock Text="Example" Style="{StaticResource BlockTitle}" />
                                <TextBlock x:Name="BackExampleText" FontStyle="Italic" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="BackSourcesText" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ContentControl>

                <!-- Rating: Study again / Know it after revealing, otherwise Reveal answer. -->
                <Grid x:Name="RatingPanel">
                    <Button x:Name="StudyAgainButton" Content="Study again" Padding="18,9" FontWeight="SemiBold"
                            HorizontalAlignment="Left" Click="OnStudyAgainClick" ToolTipService.ToolTip="Study again (Left arrow)" />
                    <Button x:Name="KnowItButton" Content="Know it" Padding="22,9" FontWeight="SemiBold"
                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="OnKnowItClick"
                            ToolTipService.ToolTip="Know it (Right arrow)" />
                    <Button x:Name="RevealButton" Content="Reveal answer" Padding="22,9" FontWeight="SemiBold"
                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="OnRevealClick"
                            ToolTipService.ToolTip="Reveal answer (Space)" />
                </Grid>

                <!-- Deck complete. -->
                <Border x:Name="DeckCompleteCard" Style="{StaticResource CardStyle}" MinHeight="360">
                    <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEC61;" FontSize="48" Foreground="{ThemeResource TealBrush}" />
                        <TextBlock Text="Deck complete" Style="{StaticResource CompletionTitle}" />
                        <TextBlock x:Name="CompletionText" Style="{StaticResource CompletionText}" />
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                            <Button x:Name="ReviewMissedButton" Content="Review missed cards" Padding="18,9" FontWeight="SemiBold"
                                    Click="OnReviewMissedClick" />
                            <Button Content="Start another deck" Padding="22,9" FontWeight="SemiBold"
                                    Style="{StaticResource AccentButtonStyle}" Click="OnNewDeckClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Infinite loop finished. -->
                <Border x:Name="InfiniteCompleteCard" Style="{StaticResource CardStyle}" MinHeight="360">
                    <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEB95;" FontSize="48" Foreground="{ThemeResource TealBrush}" />
                        <TextBlock Text="Every card mastered" Style="{StaticResource CompletionTitle}" />
                        <TextBlock x:Name="InfiniteCompletionText" Style="{StaticResource CompletionText}" />
                        <Button Content="Start a fixed deck" Padding="22,9" FontWeight="SemiBold" HorizontalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}" Click="OnStartFixedDeckClick" />
                    </StackPanel>
                </Border>

                <!-- No matching cards. -->
                <Border x:Name="EmptyCard" Style="{StaticResource CardStyle}" MinHeight="340">
                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEB95;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No matching cards" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="EmptyText" Style="{StaticResource CompletionText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
