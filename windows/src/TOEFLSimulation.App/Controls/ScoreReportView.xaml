<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TOEFLSimulation.App.Controls.ScoreReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TOEFLSimulation.App.Controls"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <UserControl.Resources>
        <!-- Theme-aware text and icon colors for elements built in code (the Mac app's TOEFLTheme). -->
        <Style x:Key="TextPrimary" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="TextSecondary" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TextTertiary" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="TextNavy" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource NavyBrush}" />
        </Style>
        <Style x:Key="TextBlue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource BlueBrush}" />
        </Style>
        <Style x:Key="TextTeal" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TealBrush}" />
        </Style>
        <Style x:Key="TextGold" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource BrandGoldBrush}" />
        </Style>
        <Style x:Key="TextCritical" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="IconPrimary" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="IconSecondary" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="IconTertiary" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="IconNavy" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource NavyBrush}" />
        </Style>
        <Style x:Key="IconBlue" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource BlueBrush}" />
        </Style>
        <Style x:Key="IconTeal" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TealBrush}" />
        </Style>
        <Style x:Key="IconGold" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource BrandGoldBrush}" />
        </Style>
        <Style x:Key="IconCritical" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <!-- A clickable card (the Mac app's .toeflCard() inside a plain Button). -->
        <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <!-- An inset panel inside a card (the Mac app's input-colored review cards). -->
        <Style x:Key="InsetStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1,7,2" />
        </Style>
        <Style x:Key="DividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header bar: heading, mode, and the Done / Close button. -->
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Padding="26,16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ModeText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="DoneButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                        Padding="22,9" FontWeight="SemiBold" VerticalAlignment="Center" Click="OnDoneClick" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1040" HorizontalAlignment="Left" Padding="30" Spacing="22">

                <!-- Score hero: ring with the overall band, CEFR, comparable 0–120 score, and timing. -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="150" Height="150" VerticalAlignment="Center">
                            <Ellipse Width="150" Height="150" StrokeThickness="14" Stroke="{ThemeResource BlueBrush}" Opacity="0.18" />
                            <Path x:Name="ScoreArc" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#056EA8" Offset="0" />
                                        <GradientStop Color="#059EAB" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                <TextBlock x:Name="OverallBandText" FontSize="42" FontWeight="Black" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource NavyBrush}" />
                                <TextBlock Text="of 6" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Practice estimate" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource NavyBrush}" />
                            <TextBlock x:Name="CefrText" FontSize="20" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="OverallExplanationText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="CompletedText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section performance: one card per section; clicking a card shows its rubric detail. -->
                <StackPanel Spacing="14">
                    <TextBlock Text="Section performance" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource NavyBrush}" />
                    <local:AdaptiveGridPanel x:Name="SectionGrid" MinItemWidth="220" Spacing="14" />
                </StackPanel>

                <!-- How the estimate works. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource NavyBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MethodologyTitleText" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource NavyBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="MethodologyText" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Answer review: one expander per section with every item's answer, key, and feedback. -->
                <StackPanel Spacing="14">
                    <TextBlock Text="Answer review" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource NavyBrush}" />
                    <StackPanel x:Name="ReviewGroupsPanel" Spacing="12" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
