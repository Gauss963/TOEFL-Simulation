<?xml version="1.0" encoding="utf-8"?>
<!--
    Theme-aware styles for the study pages and guides (the Mac app's TOEFLTheme colors as used by
    GuideComponents.swift, WordsDrillView.swift, and ReadingDrillView.swift). Code applies these styles,
    so colors follow light and dark mode through ThemeResource.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GuideNavyBrush" Color="#083863" />
            <SolidColorBrush x:Key="GuideTealBrush" Color="#05808A" />
            <SolidColorBrush x:Key="GuideActionBrush" Color="#056EA8" />
            <SolidColorBrush x:Key="GuideGoldBrush" Color="#ED991F" />
            <SolidColorBrush x:Key="GuideAquaSoftBrush" Color="#26059EAB" />
            <SolidColorBrush x:Key="GuideTealSoftBrush" Color="#1F05808A" />
            <SolidColorBrush x:Key="GuideTealKeyBrush" Color="#2E05808A" />
            <SolidColorBrush x:Key="GuideTealStrokeBrush" Color="#CC05808A" />
            <SolidColorBrush x:Key="GuideActionSoftBrush" Color="#1F056EA8" />
            <SolidColorBrush x:Key="GuideCriticalStrokeBrush" Color="#59C42B1C" />
            <SolidColorBrush x:Key="GuidePartActionBrush" Color="#12056EA8" />
            <SolidColorBrush x:Key="GuidePartTealBrush" Color="#1205808A" />
            <SolidColorBrush x:Key="GuidePartNavyBrush" Color="#12083863" />
            <SolidColorBrush x:Key="GuidePartGoldBrush" Color="#12ED991F" />
            <SolidColorBrush x:Key="GuidePartSecondaryBrush" Color="#12808080" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="GuideNavyBrush" Color="#99D6FA" />
            <SolidColorBrush x:Key="GuideTealBrush" Color="#54D6D1" />
            <SolidColorBrush x:Key="GuideActionBrush" Color="#056EA8" />
            <SolidColorBrush x:Key="GuideGoldBrush" Color="#ED991F" />
            <SolidColorBrush x:Key="GuideAquaSoftBrush" Color="#26059EAB" />
            <SolidColorBrush x:Key="GuideTealSoftBrush" Color="#1F54D6D1" />
            <SolidColorBrush x:Key="GuideTealKeyBrush" Color="#2E54D6D1" />
            <SolidColorBrush x:Key="GuideTealStrokeBrush" Color="#CC54D6D1" />
            <SolidColorBrush x:Key="GuideActionSoftBrush" Color="#33056EA8" />
            <SolidColorBrush x:Key="GuideCriticalStrokeBrush" Color="#59FF99A4" />
            <SolidColorBrush x:Key="GuidePartActionBrush" Color="#1F056EA8" />
            <SolidColorBrush x:Key="GuidePartTealBrush" Color="#1254D6D1" />
            <SolidColorBrush x:Key="GuidePartNavyBrush" Color="#1299D6FA" />
            <SolidColorBrush x:Key="GuidePartGoldBrush" Color="#12ED991F" />
            <SolidColorBrush x:Key="GuidePartSecondaryBrush" Color="#12A0A0A0" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Text colors -->
    <Style x:Key="GuideSecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="GuideNavyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource GuideNavyBrush}" />
    </Style>
    <Style x:Key="GuideTealText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource GuideTealBrush}" />
    </Style>
    <Style x:Key="GuideActionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource GuideActionBrush}" />
    </Style>
    <Style x:Key="GuideGoldText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource GuideGoldBrush}" />
    </Style>
    <Style x:Key="GuideCriticalText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style x:Key="GuideOnAccentText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Icon colors -->
    <Style x:Key="GuideSecondaryIcon" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="GuidePrimaryIcon" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="GuideNavyIcon" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource GuideNavyBrush}" />
    </Style>
    <Style x:Key="GuideTealIcon" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource GuideTealBrush}" />
    </Style>
    <Style x:Key="GuideActionIcon" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource GuideActionBrush}" />
    </Style>
    <Style x:Key="GuideCriticalIcon" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- Legend dots -->
    <Style x:Key="GuideActionDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource GuideActionBrush}" />
    </Style>
    <Style x:Key="GuideTealDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource GuideTealBrush}" />
    </Style>

    <!-- Hairline divider -->
    <Style x:Key="GuideDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- Surfaces inside cards (the Mac "input" background) -->
    <Style x:Key="GuideInsetBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="GuideInsetStrokedBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="GuideActionCircle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuideActionBrush}" />
    </Style>
    <Style x:Key="GuideAquaChip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuideAquaSoftBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,3,8,3" />
    </Style>
    <Style x:Key="GuideChip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Padding" Value="10,5,10,5" />
    </Style>
    <Style x:Key="GuideWeakChip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GuideCriticalStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Padding" Value="10,5,10,5" />
    </Style>

    <!-- Checked blanks -->
    <Style x:Key="GuideCorrectBox" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuideTealSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GuideTealStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="3,2,3,2" />
    </Style>
    <Style x:Key="GuideWrongBox" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="3,2,3,2" />
    </Style>
    <Style x:Key="GuideAnswerBox" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="3,2,3,2" />
    </Style>

    <!-- Reading options -->
    <Style x:Key="GuideOptionNone" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,4,10,4" />
    </Style>
    <Style x:Key="GuideOptionSelected" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuideActionSoftBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,4,10,4" />
    </Style>
    <Style x:Key="GuideOptionKey" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuideTealKeyBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,4,10,4" />
    </Style>
    <Style x:Key="GuideOptionWrong" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,4,10,4" />
    </Style>

    <!-- Annotated model email parts: tinted background and a colored bar on the leading edge -->
    <Style x:Key="GuidePartAction" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuidePartActionBrush}" />
    </Style>
    <Style x:Key="GuidePartTeal" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuidePartTealBrush}" />
    </Style>
    <Style x:Key="GuidePartNavy" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuidePartNavyBrush}" />
    </Style>
    <Style x:Key="GuidePartGold" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuidePartGoldBrush}" />
    </Style>
    <Style x:Key="GuidePartSecondary" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuidePartSecondaryBrush}" />
    </Style>
    <Style x:Key="GuideBarAction" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuideActionBrush}" />
    </Style>
    <Style x:Key="GuideBarTeal" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuideTealBrush}" />
    </Style>
    <Style x:Key="GuideBarNavy" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuideNavyBrush}" />
    </Style>
    <Style x:Key="GuideBarGold" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GuideGoldBrush}" />
    </Style>
    <Style x:Key="GuideBarSecondary" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
</ResourceDictionary>
