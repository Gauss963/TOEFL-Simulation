<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinUI 3 (Windows App SDK) desktop app. Unpackaged and self-contained: users unzip and run it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>TOEFLSimulation.App</RootNamespace>
    <AssemblyName>TOEFLSimulation</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Builds the resources.pri that unpackaged WinUI apps need to load their XAML and WinUI's own resources. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <!-- Microphone recording (16 kHz mono WAV) and offline speech recognition for Speaking scores. -->
    <PackageReference Include="NAudio" Version="3.2.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TOEFLSimulation.Core\TOEFLSimulation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon-32.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Mac app's resources, used in place so the question bank and audio never drift apart. -->
    <Content Include="$(MacResourcesDir)**\*" LinkBase="Resources" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
