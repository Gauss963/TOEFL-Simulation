<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral logic: models, question bank, exam sessions, scoring, and saved progress.
       It has no Windows dependency, so its tests also run on macOS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TOEFLSimulation.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TOEFLSimulation.Core.Tests" />
  </ItemGroup>
</Project>
